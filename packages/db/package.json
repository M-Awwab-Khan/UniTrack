{
  "name": "@uni-track/db",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "default": "./src/schema/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "seed:admin": "bun run --env-file .env src/seed-admin.ts"
  },
  "devDependencies": {
    "@uni-track/config": "workspace:*",
    "drizzle-kit": "^0.31.8",
    "typescript": "catalog:"
  },
  "dependencies": {
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.1",
    "postgres": "^3.4.7",
    "zod": "catalog:"
  }
}